	def check_mineral_stabilities(self):

		#Warns, like MATE v1.x, when amphibole/garnet/spinel fractions exist
		#outside their stability fields. Does not modify the composition.

		depth = self.plot_arrays['depth']
		p = self.plot_arrays['p']

		amp = self.plot_arrays['amp']
		idx_amp_out = np.where((p > self.amp_stab_P) & (amp > 0.0))[0]
		if len(idx_amp_out) > 0:
			QMessageBox.about(self, 'Warning!',
				'Amphibole content was found out of the stability field, below ' +
				str(round(float(depth[np.argmin(np.abs(p - self.amp_stab_P))]), 1)) + ' km.')

		gt = self.plot_arrays['gt']
		idx_gt_out = np.where((depth < self.sp_gt_transition) & (gt > 0.0))[0]
		if len(idx_gt_out) > 0:
			QMessageBox.about(self, 'Warning!',
				'Garnet content was found above the spinel-garnet transition (' +
				str(self.sp_gt_transition) + ' km).')

		sp = self.plot_arrays['sp']
		idx_sp_out = np.where((depth > self.sp_gt_transition) & (sp > 0.0))[0]
		if len(idx_sp_out) > 0:
			QMessageBox.about(self, 'Warning!',
				'Spinel content was found below the spinel-garnet transition (' +
				str(self.sp_gt_transition) + ' km).')

