	def MT_model_rms(self):

		#RMS misfit between the last imported resistivity profile and the last
		#calculated model, both interpolated on the model depth grid.

		if (self.model_built == False) or (len(self.mt_profiles) == 0) or (len(self.cond_runs) == 0):
			return None

		profile = self.mt_profiles[-1]
		model = self.cond_runs[-1]

		with np.errstate(divide = 'ignore'):
			model_res = 1.0 / model['cond']

		common_min = max(np.amin(profile['depth']), np.amin(model['depth']))
		common_max = min(np.amax(profile['depth']), np.amax(model['depth']))

		mask = (model['depth'] >= common_min) & (model['depth'] <= common_max)
		if np.sum(mask) < 2:
			return None

		f_profile = interp1d(profile['depth'], profile['res'], bounds_error = False)
		profile_on_model = f_profile(model['depth'][mask])

		misfit = (np.log10(profile_on_model) - np.log10(model_res[mask])) / self.mt_err_floor
		misfit = misfit[~np.isnan(misfit)]

		return float(np.sqrt(np.mean(misfit ** 2.0)))

