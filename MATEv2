		#Extracting the vertical resistivity column at the selected location,
		#following the v1.x define_profile logic (rho[z][y][x], nearest mesh centers).

		self.modem_curve_method = self.modem_method_combo.currentIndex()

		if self.modem_curve_method == 0:

			if self.modem_dat_read == False:
				QMessageBox.about(self, 'Warning!',
					'You have to import a ModEM .dat file first to select by station.')
				return

			self.modem_station_select = self.modem_station_combo.currentIndex()
			posx = self.station_posx[self.modem_station_select]
			posy = self.station_posy[self.modem_station_select]
			label = self.station_name[self.modem_station_select]

		else:

			try:
				posx = float(self.modem_posx_box.text())
				posy = float(self.modem_posy_box.text())
			except ValueError:
				QMessageBox.critical(self.mt_curve_pop, 'MATE 2.0', 'Positions must be numeric.')
				return

			self.modem_posx = posx
			self.modem_posy = posy
			label = 'x:' + str(posx) + ' y:' + str(posy)

		idx_x = (np.abs(self.x_mesh_center - posx)).argmin()
		idx_y = (np.abs(self.y_mesh_center - posy)).argmin()

		res_profile = []
		for i in range(0, len(self.rho)):
			res_profile.append(self.rho[i][idx_y][idx_x])

		profile = {'depth': np.asarray(self.z_mesh_center), 'res': np.asarray(res_profile),
			'res_max': None, 'res_min': None, 'label': 'ModEM: ' + label, 'step': True}

		self.mt_profiles.append(profile)

		QMessageBox.information(self, 'MATE 2.0',
			'The resistivity profile at ' + label + ' is submitted. It will be drawn on the conductivity panel.')

		if self.model_built:
			self.plot_conductivity(method = 'draw')
			self.canvas.draw()

