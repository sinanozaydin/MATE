		filename, _ = QFileDialog.getOpenFileName(self, 'Import xenolith P-T file',
			self.working_path, 'CSV files (*.csv);;All files (*)')

		if filename == '':
			return

		try:
			data = pd.read_csv(filename)
			self.xen_T = pd.to_numeric(data.iloc[:, 0], errors = 'coerce').to_numpy()
			self.xen_P = pd.to_numeric(data.iloc[:, 1], errors = 'coerce').to_numpy()
			valid = ~(np.isnan(self.xen_T) | np.isnan(self.xen_P))
			self.xen_T = self.xen_T[valid]
			self.xen_P = self.xen_P[valid]
		except Exception as exc:
			QMessageBox.critical(self, 'MATE 2.0', 'Could not read the xenolith file:\n' + str(exc))
			return

		if len(self.xen_T) == 0:
			QMessageBox.critical(self, 'MATE 2.0', 'No valid T-P pairs were found in the file.')
			return

		self.xen_exists = True
		QMessageBox.information(self, 'MATE 2.0', str(len(self.xen_T)) +
			' xenolith P-T points imported. They will be drawn on the geotherm panel.')

		if self.model_built:
			self.plot_geotherm(method = 'draw')
			self.canvas.draw()

	def xenolith_RMS(self):

		#RMS misfit between the xenolith temperatures and the current geotherm,
		#evaluated at the xenolith pressures.

		if (self.xen_exists == False) or (self.model_built == False):
			return None

		p_model = self.plot_arrays['p']
		T_model = self.plot_arrays['T'] - 273.15

		inside = (self.xen_P >= np.amin(p_model)) & (self.xen_P <= np.amax(p_model))
		if np.sum(inside) == 0:
			return None

		f_geo = interp1d(p_model, T_model)
		T_eq = f_geo(self.xen_P[inside])

		rms = ((1.0 / float(np.sum(inside))) *
			np.sum(((self.xen_T[inside] - T_eq) ** 2.0) / (self.xen_T_err ** 2.0))) ** 0.5

		return rms

