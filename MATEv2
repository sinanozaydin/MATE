def silent_call(func, *args, **kwargs):

	#pide's list_* methods print their catalogues to the terminal. This wrapper
	#silences those print-outs while keeping the returned lists.

	buffer = io.StringIO()
	with contextlib.redirect_stdout(buffer):
		result = func(*args, **kwargs)
	return result

def step_interpolate(row_depths, row_values, target_depths):

	#Step-hold interpolation: each composition row is valid from its own depth
	#down to the depth of the next row, mirroring MATE v1.x behaviour.

	row_depths = np.asarray(row_depths, dtype = float)
	row_values = np.asarray(row_values, dtype = float)
	idx = np.searchsorted(row_depths, target_depths, side = 'right') - 1
	idx = np.clip(idx, 0, len(row_values) - 1)

	return row_values[idx]

def read_raw_csv(filename, delim):

	#Simple csv reading function retained from MATE v1.x, used for the ModEM
	#file formats where rows have varying lengths.

	import csv as csv_module

	with open(filename, 'rt', encoding = 'utf8') as file_obj:
		file_csv = csv_module.reader(file_obj, delimiter = delim)
		data = []
		for row in file_csv:
			data.append([cell for cell in row if cell != ''])

	return data

