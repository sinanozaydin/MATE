	def load_composition_csv(self):

		filename, _ = QFileDialog.getOpenFileName(self.comp_pop, 'Load composition file',
			self.working_path, 'CSV files (*.csv);;All files (*)')

		if filename == '':
			return

		try:
			df = pd.read_csv(filename)
		except Exception as exc:
			QMessageBox.critical(self.comp_pop, 'MATE 2.0', 'Could not read the file:\n' + str(exc))
			return

		#Mapping the loaded columns onto the expected column set, filling absentees.
		new_df = pd.DataFrame(columns = TABLE_COLUMNS)
		for col in TABLE_COLUMNS:
			if col in df.columns:
				new_df[col] = pd.to_numeric(df[col], errors = 'coerce')
			else:
				new_df[col] = 0.0
		new_df = new_df.fillna(0.0)

		self.table_model.load_dataframe(new_df)
		self.model_built = False

	def save_composition_csv(self):

		filename, _ = QFileDialog.getSaveFileName(self.comp_pop, 'Save composition file',
			self.working_path, 'CSV files (*.csv)')

		if filename == '':
			return

		if not filename.endswith('.csv'):
			filename = filename + '.csv'

		self.table_model.df.to_csv(filename, index = False)

	def add_table_row(self):

		selection = self.table_view.selectionModel().selectedIndexes()
		if selection:
			position = max(idx.row() for idx in selection) + 1
		else:
			position = self.table_model.rowCount()
		self.table_model.insert_row(position)

	def remove_table_rows(self):

		selection = self.table_view.selectionModel().selectedIndexes()
		if not selection:
			return
		rows = [idx.row() for idx in selection]
		self.table_model.remove_rows(rows)

