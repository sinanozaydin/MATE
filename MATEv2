	def build_pide_model(self):

		#Constructs the pide object from the composition table, the geotherm
		#settings and the selected models, then calculates water distribution,
		#electrical conductivity and seismic velocities.

		df = self.table_model.df.copy()
		df = df.sort_values('Depth(km)').reset_index(drop = True)

		if df['Depth(km)'].duplicated().any():
			raise ValueError('Composition table contains duplicate depth entries.')

		frac_cols = ['ol_frac', 'opx_frac', 'cpx_frac', 'gt_frac', 'sp_chr_frac',
			'pl_frac', 'amp_frac', 'cond_frac']
		frac_sums = df[frac_cols].sum(axis = 1)
		if np.any(np.abs(frac_sums - 100.0) > 1e-6):
			raise ValueError('Mineral fractions do not sum to 100 in at least one row of the composition table.')

		self.progressBar.setValue(5)

		#Geotherm through pide.

		self.T, self.depth, self.p, idx_lab = calculate_hasterok2011_geotherm(
			SHF = self.q_0, T_0 = self.T_0, max_depth = self.lab, moho = self.moho,
			adiabat = True)

		if self.adiabat_method == 0:
			#Rebuilding without the adiabat intersection.
			result = calculate_hasterok2011_geotherm(SHF = self.q_0, T_0 = self.T_0,
				max_depth = self.lab, moho = self.moho, adiabat = False)
			self.T, self.depth, self.p = result[0], result[1], result[2]

		self.progressBar.setValue(15)

		#Restricting the calculation to depths at or below the first table row,
		#in the same spirit as the v1.x moho/interpretation cutoff.

		first_depth = df['Depth(km)'].iloc[0]
		self.idx_calc = np.where(self.depth >= first_depth)[0]

		mask = self.idx_calc
		T_calc = self.T[mask]
		p_calc = self.p[mask]
		depth_calc = self.depth[mask]

		row_depths = df['Depth(km)'].to_numpy()

		def col(name):
			return step_interpolate(row_depths, df[name].to_numpy(), depth_calc)

		#Interpolating table columns onto the calculation grid.

		ol = col('ol_frac') / 100.0
		opx = col('opx_frac') / 100.0
		cpx = col('cpx_frac') / 100.0
		gt = col('gt_frac') / 100.0
		sp = col('sp_chr_frac') / 100.0
		mica = col('pl_frac') / 100.0
		amp = col('amp_frac') / 100.0
		cond_phase = col('cond_frac') / 100.0

		if np.any(cond_phase > 0.0):
			print(bcolors.RED + 'Warning: user-defined conductive phase (cond_frac) is not wired '
				'to pide yet and will be redistributed to olivine.' + bcolors.NC)
			ol = ol + cond_phase

		h2o_bulk = col('H2O_bulk(ppm)')
		melt_frac = col('melt_mass_frac')
		co2_melt = col('CO2_melt(ppm)')
		na2o_melt = col('Na2O_melt(wt%)')
		k2o_melt = col('K2O_melt(wt%)')

		self.progressBar.setValue(25)

		#Building the pide object.

		a = pide_class()
		self.pide_obj = a

		a.set_temperature(T_calc)
		a.set_pressure(p_calc)
		#Passing depth as a list: pide 1.3's set_depth performs a string comparison
		#(depth == 'auto') that raises with numpy arrays.
		a.set_depth(list(depth_calc))

		a.set_composition_solid_mineral(ol = ol, opx = opx, cpx = cpx, garnet = gt,
			sp = sp, mica = mica, amp = amp)

		a.set_xfe_mineral(ol = col('XFe-ol'), opx = col('XFe-opx'),
			cpx = col('XFe-cpx'), garnet = col('XFe-gt'))

		a.set_alopx(col('Al-opx(wt%)'))
		#param1: Ti content for olivine, F content for phlogopite (fl_pl column).
		a.set_param1_mineral(ol = col('Ti-ol(wt%)'), mica = col('fl_pl(wt%)'))
		#ti_ol has to be registered separately for Ti-dependent solubility models.
		a.set_parameter('ti_ol', col('Ti-ol(wt%)'))
		a.set_grain_size(ol = col('ol_gs(mm)'))

		a.set_watercalib(ol = self.ol_calib, px_gt = self.px_gt_calib)
		a.set_o2_buffer(self.o2_buffer)

		a.set_mineral_conductivity_choice(
			ol = self._cond_choice(self.ol_cond_selection, self.ol_mech_selection),
			opx = self._cond_choice(self.opx_cond_selection, self.opx_mech_selection),
			cpx = self._cond_choice(self.cpx_cond_selection, self.cpx_mech_selection),
			garnet = self._cond_choice(self.gt_cond_selection, self.gt_mech_selection),
			mica = self.mica_cond_selection, amp = self.amp_cond_selection,
			sp = self.sp_cond_selection)

		a.set_melt_fluid_conductivity_choice(melt = self.melt_cond_selection)

		a.set_mantle_water_partitions(opx_ol = self.opx_ol_part_selection,
			cpx_ol = self.cpx_ol_part_selection, garnet_ol = self.gt_ol_part_selection,
			ol_melt = self.ol_melt_part_selection, opx_melt = self.opx_melt_part_selection,
			cpx_melt = self.cpx_melt_part_selection, garnet_melt = self.gt_melt_part_selection)

		a.set_mantle_water_solubility(ol = self.ol_sol_selection,
			opx = self.opx_sol_selection, cpx = self.cpx_sol_selection,
			garnet = self.gt_sol_selection)

		#Grain-boundary hydrogen diffusion settings.

		if self.gb_diffusion:
			a.set_grain_boundary_H_Diffusion(True)
			a.set_grain_boundary_water_partitioning(self.gb_partitioning)

		#Melt setup, only when the table contains any melt.

		self.melt_exists = bool(np.any(melt_frac > 0.0))
		if self.melt_exists:
			a.set_melt_or_fluid_mode('melt')
			a.set_melt_fluid_frac(melt_frac)
			a.set_melt_properties(co2 = co2_melt, na2o = na2o_melt, k2o = k2o_melt)
			a.set_melt_fluid_interconnectivity(col('m_melt'))

		#Phase interconnectivities from the m_* columns.

		a.set_phase_interconnectivities(ol = col('m_ol'), opx = col('m_opx'),
			cpx = col('m_cpx'), garnet = col('m_gt'), sp = col('m_sp_chr'),
			mica = col('m_pl'), amp = col('m_amp'))

		a.set_solid_phs_mix_method(self.phs_mix_selection)
		a.set_solid_melt_fluid_mix_method(self.phs_melt_mix_selection)

		a.set_seismic_attenuation(self.seis_attenuation_list[self.seis_attenuation_selection])

		self.progressBar.setValue(40)

		#Water distribution among minerals from the bulk water column.

		a.set_bulk_water(h2o_bulk)
		a.mantle_water_distribute(method = 'array')

		if self.solubility_check:
			try:
				max_water = a.calculate_bulk_mantle_water_solubility(method = 'array')
				exceed = np.where(h2o_bulk > max_water)[0]
				if len(exceed) > 0:
					print(bcolors.RED + 'Warning: bulk water exceeds the bulk solubility limit at '
						+ str(len(exceed)) + ' node(s). Consider lowering H2O_bulk.' + bcolors.NC)
			except Exception as exc:
				print(bcolors.RED + 'Solubility check could not be performed: ' + str(exc) + bcolors.NC)

		self.progressBar.setValue(60)

		#Electrical conductivity.

		self.bulk_cond = a.calculate_conductivity(method = 'array')

		self.progressBar.setValue(80)

		#Seismic velocities through pide/santex.
		#pide 1.3 cannot run its seismic path while mechanism-restricted (string)
		#conductivity choices are set, so the choices are reset to their integer
		#form here. Seismic velocities do not depend on the conductivity models.

		if (self.ol_mech_selection + self.opx_mech_selection +
			self.cpx_mech_selection + self.gt_mech_selection) != 0:
			a.set_mineral_conductivity_choice(ol = self.ol_cond_selection,
				opx = self.opx_cond_selection, cpx = self.cpx_cond_selection,
				garnet = self.gt_cond_selection, mica = self.mica_cond_selection,
				amp = self.amp_cond_selection, sp = self.sp_cond_selection)

		try:
			self.v_bulk, self.v_p, self.v_s = a.calculate_seismic_velocities(
				mixing_method = self.seis_mixing_list[self.seis_mixing_selection],
				method = 'array')
			if self.plot_anelastic and self.seis_attenuation_selection != 0:
				self.v_p_anelastic = a.v_anelasticity_p
				self.v_s_anelastic = a.v_anelasticity_s
			else:
				self.v_p_anelastic = None
				self.v_s_anelastic = None
			self.seismic_available = True
		except Exception as exc:
			print(bcolors.RED + 'Seismic velocities could not be calculated: ' + str(exc) + bcolors.NC)
			self.seismic_available = False

		#Storing the composition arrays for plotting.

		self.plot_arrays = {
			'depth': depth_calc, 'T': T_calc, 'p': p_calc, 'T_full': self.T, 'p_full': self.p, 'depth_full' : self.depth,
			'ol': ol, 'opx': opx, 'cpx': cpx, 'gt': gt, 'sp': sp,
			'mica': mica, 'amp': amp, 'melt': melt_frac,
			'h2o_bulk': h2o_bulk,
			'ol_h2o': a.ol_water, 'opx_h2o': a.opx_water,
			'cpx_h2o': a.cpx_water, 'gt_h2o': a.garnet_water}

		self.progressBar.setValue(100)
		self.model_built = True
		self.run_counter = self.run_counter + 1

	def calculate_model_button(self):

		self.progressBar.setValue(0)

		try:
			self.build_pide_model()
		except Exception as exc:
			self.progressBar.setValue(0)
			QMessageBox.critical(self, 'MATE 2.0', 'The model could not be calculated:\n\n' + str(exc))
			return

		label = 'Run ' + str(self.run_counter)

		self.geotherm_runs.append({'depth': self.plot_arrays['depth_full'],
			'T': self.plot_arrays['T_full'], 'label': label})

		self.water_runs.append({'depth': self.plot_arrays['depth'],
			'ol': self.plot_arrays['ol_h2o'], 'opx': self.plot_arrays['opx_h2o'],
			'cpx': self.plot_arrays['cpx_h2o'], 'gt': self.plot_arrays['gt_h2o'],
			'bulk': self.plot_arrays['h2o_bulk'], 'label': label})

		self.cond_runs.append({'depth': self.plot_arrays['depth'],
			'cond': np.array(self.bulk_cond), 'label': label,
			'linestyle': self.condlinestyle_list[self.condlinestyle_select],
			'linewidth': self.condlinewidth})

		if self.seismic_available:
			run = {'depth': self.plot_arrays['depth'], 'vp': np.array(self.v_p),
				'vs': np.array(self.v_s), 'label': label}
			if self.v_p_anelastic is not None:
				run['vp_anelastic'] = np.array(self.v_p_anelastic)
				run['vs_anelastic'] = np.array(self.v_s_anelastic)
			self.seis_runs.append(run)

		#Mineral stability warnings, like v1.x behaviour.
		self.check_mineral_stabilities()

		#Drawing everything after a successful calculation.
		self.redraw_all()

	def redraw_all(self):
 
		self.plot_composition(method = 'draw')
		self.plot_geotherm(method = 'draw')
		self.plot_water(method = 'draw')
		self.plot_conductivity(method = 'draw')
		self.plot_seismic(method = 'draw')
		self.draw_canvas()
 
	def draw_canvas(self):
 
		#Fitting the subplot2grid panels tightly into the canvas window, as in
		#MATE v1.x. UserWarning is suppressed since tight_layout occasionally
		#complains about the fixed 16-row grid geometry while still succeeding.
 
		with warnings.catch_warnings():
			warnings.simplefilter('ignore', UserWarning)
			self.fig.tight_layout()
 
		self.canvas.draw()
 
	def require_model(self):
 
		if self.model_built == False:
			QMessageBox.information(self, 'MATE 2.0',
				'No calculated model exists yet. Press Calculate Model first.')
			return False
 
		return True
 
	#---------------------------------------------------------------------------
	#Plotting functions
	#The main canvas is divided into five linked depth columns:
	#Composition | Geotherm | Water | Conductivity | Seismic velocities
	#---------------------------------------------------------------------------

	def require_model(self):

		if self.model_built == False:
			QMessageBox.information(self, 'MATE 2.0',
				'No calculated model exists yet. Press Calculate Model first.')
			return False

		return True

	#---------------------------------------------------------------------------
	#Plotting functions
	#The main canvas is divided into five linked depth columns:
	#Composition | Geotherm | Water | Conductivity | Seismic velocities
	#---------------------------------------------------------------------------

	def _get_axis(self, key, position, colspan, method):

		if method == 'save':
			fig = plt.figure(figsize = (4, 7))
			return fig.add_subplot(111), fig

		if key not in self.axes:
			self.axes[key] = plt.subplot2grid((16, 23), (0, position),
				rowspan = 16, colspan = colspan, fig = self.fig)

		return self.axes[key], self.fig

	def _depth_decor(self, ax, show_ylabel = False):

		ax.axhline(self.moho, linestyle = '--', color = '#BA43C2', alpha = 0.85, linewidth = 2.0)
		ax.axhline(self.lab, linestyle = '--', color = 'k', alpha = 0.85, linewidth = 2.0)
		ax.set_ylim(self.lab + 25.0, 0.0)
		if show_ylabel:
			ax.set_ylabel(r'$Depth \, (km)$', fontsize = 9)

		crust_obj = patches.Rectangle((ax.get_xlim()[0], 0), 1e12, self.moho,
			color = '#b76314', alpha = 0.35, hatch = 'xxxx')
		ax.add_patch(crust_obj)

	def plot_composition(self, method = None):

		ax, fig = self._get_axis('comp', 0, 4, method)
		ax.clear()

		d = self.plot_arrays['depth']
		labels = ['Ol', 'Opx', 'Cpx', 'Gt', 'Sp-Chr', 'Phlg', 'Amp']
		keys = ['ol', 'opx', 'cpx', 'gt', 'sp', 'mica', 'amp']
		colors_comp = ['#78b356', '#b3a556', '#56a2b3', '#b35656', '#8b8b8b',
			'#a86bc9', '#4b6584']

		cumulative = np.zeros(len(d))
		for key, label, color in zip(keys, labels, colors_comp):
			values = self.plot_arrays[key] * 100.0
			if np.any(values > 0.0):
				ax.fill_betweenx(d, cumulative, cumulative + values,
					color = color, label = label, alpha = 0.85)
			cumulative = cumulative + values

		ax.set_xlim(0, 100)
		ax.set_xlabel(r'$Modal \, \%$', fontsize = 9)
		self._depth_decor(ax, show_ylabel = True)
		ax.legend(fontsize = 6, loc = 'lower left')
		ax.set_title('Composition', fontsize = 9)

		if method == 'save':
			self.figure_comp_save = fig

	def plot_geotherm(self, method = None):

		ax, fig = self._get_axis('geotherm', 4, 4, method)
		ax.clear()

		for i, run in enumerate(self.geotherm_runs):
			color = self.color_cycle[i % len(self.color_cycle)]
			ax.plot(run['T'] - 273.15, run['depth'], linewidth = 2.0, color = color,
				label = run['label'])

		#Katz (2003) solidus overlay through pide.
		if self.solidus_plot and self.model_built:
			T_sol = self.calculate_solidus(self.plot_arrays['p'])
			ax.plot(T_sol, self.plot_arrays['depth'], linewidth = 2.0, color = '#D83A3A',
				linestyle = ':', label = 'Solidus')

		#Spinel-garnet transition line.
		if self.plot_sp_gt_line:
			ax.axhline(self.sp_gt_transition, linestyle = '--', color = '#7EB345',
				alpha = 0.85, linewidth = 2.0)

		#Xenolith P-T points with error bars.
		if self.xen_exists and self.model_built:
			p_model = self.plot_arrays['p']
			d_model = self.plot_arrays['depth']
			f_depth = interp1d(p_model, d_model, bounds_error = False)
			xen_depth = f_depth(self.xen_P)
			depth_err = self.xen_P_err * (np.amax(d_model) - np.amin(d_model)) / (np.amax(p_model) - np.amin(p_model))
			ax.errorbar(self.xen_T, xen_depth, xerr = self.xen_T_err, yerr = depth_err,
				fmt = 'o', color = 'k', markersize = 4, capsize = 2, label = 'Xenoliths')
			rms = self.xenolith_RMS()
			if rms is not None:
				ax.set_title('Geotherm | Xen RMS: ' + str(round(rms, 2)), fontsize = 9)
			else:
				ax.set_title('Geotherm', fontsize = 9)
		else:
			ax.set_title('Geotherm', fontsize = 9)

		ax.set_xlim(0, self.geotherm_up)
		ax.set_xlabel(r'$Temperature \, (C^{\circ})$', fontsize = 9)
		self._depth_decor(ax)
		ax.set_yticks([]) if method != 'save' else None

		if method == 'save':
			self.figure_geotherm_save = fig

	def plot_water(self, method = None):

		ax, fig = self._get_axis('water', 8, 5, method)
		ax.clear()

		if len(self.water_runs) > 0:
			run = self.water_runs[-1]
			ax.plot(run['bulk'], run['depth'], linewidth = 2.2, color = 'k', label = 'Bulk')
			ax.plot(run['ol'], run['depth'], linewidth = 1.6, color = '#78b356', label = 'Ol')
			ax.plot(run['opx'], run['depth'], linewidth = 1.6, color = '#b3a556', label = 'Opx')
			ax.plot(run['cpx'], run['depth'], linewidth = 1.6, color = '#56a2b3', label = 'Cpx')
			ax.plot(run['gt'], run['depth'], linewidth = 1.6, color = '#b35656', label = 'Gt')
			ax.legend(fontsize = 6, loc = 'lower right')

		#Imported water measurement overlay.
		if self.water_meas is not None:
			ax.errorbar(self.water_meas['water'], self.water_meas['depth'],
				xerr = self.water_meas['err'], fmt = 's', color = 'k',
				markersize = 4, capsize = 2, label = 'Measurements')
			ax.legend(fontsize = 6, loc = 'lower right')

		ax.set_xlim(0, self.waterplotlim_up)
		ax.set_xlabel(r'$Water \, Content \, (ppm \, wt)$', fontsize = 9)
		self._depth_decor(ax)
		ax.set_yticks([]) if method != 'save' else None
		ax.set_title('Water Distribution', fontsize = 9)

		if method == 'save':
			self.figure_water_save = fig

	def plot_conductivity(self, method = None):

		ax, fig = self._get_axis('cond', 13, 5, method)
		ax.clear()

		#Imported MT/resistivity profiles.
		for j, profile in enumerate(self.mt_profiles):
			if profile['step']:
				ax.step(profile['res'], profile['depth'], where = 'post', linewidth = 1.6,
					color = '#5b5e5d', alpha = 0.9, label = profile['label'])
			else:
				ax.plot(profile['res'], profile['depth'], linewidth = 1.6,
					color = '#5b5e5d', alpha = 0.9, label = profile['label'])

			if profile['res_max'] is not None:
				ax.fill_betweenx(profile['depth'], profile['res_min'], profile['res_max'],
					color = '#5b5e5d', alpha = 0.25)

		for i, run in enumerate(self.cond_runs):
			color = self.color_cycle[i % len(self.color_cycle)]
			with np.errstate(divide = 'ignore'):
				resistivity = 1.0 / run['cond']
			ax.plot(resistivity, run['depth'], linewidth = run.get('linewidth', 2.0),
				linestyle = run.get('linestyle', '-'), color = color, label = run['label'])

		ax.set_xscale('log')
		ax.set_xlim(self.condplotlim_down, self.condplotlim_up)
		ax.set_xlabel(r'$Resistivity \, (\Omega m)$', fontsize = 9)
		self._depth_decor(ax)
		ax.set_yticks([]) if method != 'save' else None

		rms = self.MT_model_rms()
		if rms is not None:
			ax.set_title('Electrical Resistivity | RMS: ' + str(round(rms, 2)), fontsize = 9)
		else:
			ax.set_title('Electrical Resistivity', fontsize = 9)

		if method == 'save':
			self.figure_cond_save = fig

	def plot_seismic(self, method = None):

		ax, fig = self._get_axis('seis', 18, 5, method)
		ax.clear()

		for i, run in enumerate(self.seis_runs):
			color = self.color_cycle[i % len(self.color_cycle)]
			ax.plot(run['vp'], run['depth'], linewidth = 2.0, color = color,
				linestyle = '-', label = run['label'] + r' $V_P$')
			ax.plot(run['vs'], run['depth'], linewidth = 2.0, color = color,
				linestyle = '--', label = run['label'] + r' $V_S$')
			if 'vp_anelastic' in run:
				ax.plot(run['vp_anelastic'], run['depth'], linewidth = 1.2, color = color,
					linestyle = '-', alpha = 0.5)
				ax.plot(run['vs_anelastic'], run['depth'], linewidth = 1.2, color = color,
					linestyle = '--', alpha = 0.5)

		ax.set_xlabel(r'$Velocity \, (km/s)$', fontsize = 9)
		self._depth_decor(ax)
		ax.set_yticks([]) if method != 'save' else None
		ax.set_title('Seismic Velocities', fontsize = 9)

		if method == 'save':
			self.figure_seis_save = fig

