	def read_ModEM_dat(self, filename):

		#Ported from MATE v1.x. Reads station names and positions from the
		#ModEM data file.

		dat_data = read_raw_csv(filename, delim = ' ')

		self.station_name = []
		self.station_lat = []
		self.station_lon = []
		self.station_posx = []
		self.station_posy = []

		try:
			dash_found = False
			limitlines = len(dat_data)
			for row in range(8, len(dat_data)):
				if dat_data[row][0] == '#':
					limitlines = row - 1
					dash_found = True
					break

			for row in range(8, limitlines):
				if dat_data[row][1] != dat_data[row - 1][1]:
					self.station_name.append(dat_data[row][1])
					self.station_lat.append(float(dat_data[row][2]))
					self.station_lon.append(float(dat_data[row][3]))
					self.station_posx.append(float(dat_data[row][4]))
					self.station_posy.append(float(dat_data[row][5]))
		except IndexError:
			QMessageBox.about(self, 'Warning!', 'Structure of the file seems to be wrong.')
			return

		self.st_item_list = []
		for i in range(0, len(self.station_name)):
			self.st_item_list.append(str(i) + ' - ' + self.station_name[i])

		self.modem_dat_read = True

		QMessageBox.about(self, 'Success', str(filename) +
			' file was succesfully imported to the program!')

