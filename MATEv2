	def read_csv_MT_file(self, filename):

		#csv MT profile: depth(km), res(ohm m), res_max(ohm m), res_min(ohm m).
		#A header line is expected. res_max and res_min columns are optional.

		try:
			data = pd.read_csv(filename)
			z_depth = pd.to_numeric(data.iloc[:, 0], errors = 'coerce').to_numpy()
			res = pd.to_numeric(data.iloc[:, 1], errors = 'coerce').to_numpy()
			if data.shape[1] >= 4:
				res_max = pd.to_numeric(data.iloc[:, 2], errors = 'coerce').to_numpy()
				res_min = pd.to_numeric(data.iloc[:, 3], errors = 'coerce').to_numpy()
			else:
				res_max = None
				res_min = None
		except Exception as exc:
			QMessageBox.about(self, 'Warning!', 'Structure of the csv file seems to be wrong:\n' + str(exc))
			return

		valid = ~(np.isnan(z_depth) | np.isnan(res))
		z_depth = z_depth[valid]
		res = res[valid]
		if res_max is not None:
			res_max = np.nan_to_num(res_max[valid])
			res_min = np.nan_to_num(res_min[valid])

		profile = {'depth': z_depth, 'res': res, 'res_max': res_max, 'res_min': res_min,
			'label': os.path.basename(filename), 'step': self.csv_step_plot}

		self.mt_profiles.append(profile)

		QMessageBox.about(self, 'Success', str(filename) +
			' file was succesfully imported to the program!')

		if self.model_built:
			self.plot_conductivity(method = 'draw')
			self.canvas.draw()

