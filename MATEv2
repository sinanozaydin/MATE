	def read_ModEM_rho(self, filename):

		#Ported from MATE v1.x. Reads the ModEM resistivity model into
		#rho[z][y][x] and constructs mesh center coordinate arrays.

		rho_data = read_raw_csv(filename, delim = ' ')

		self.x_num = int(rho_data[1][0])
		self.y_num = int(rho_data[1][1])
		self.z_num = int(rho_data[1][2])

		x_grid = np.array(rho_data[2], dtype = float)
		y_grid = np.array(rho_data[3], dtype = float)
		z_grid = np.array(rho_data[4], dtype = float)

		rho = []
		for k in range(5, len(rho_data) - 2, self.y_num):
			rhoy = []
			for z in range(k, k + self.y_num):
				rhox = []
				for l in range(0, self.x_num):
					rhox.append(float(rho_data[z][l]))
				rhoy.append(rhox)
			rho.append(rhoy)

		self.rho = np.exp(np.asarray(rho))

		z_depth = np.append(np.array([0.0]), np.cumsum(z_grid))
		self.z_mesh_center = []
		for i in range(1, len(z_depth)):
			self.z_mesh_center.append((((z_depth[i] - z_depth[i - 1]) / 2.0) + z_depth[i - 1]) / 1000.0)
		self.z_mesh_center = np.asarray(self.z_mesh_center)

		#Constructing the horizontal cumulative grids centered on the model center.

		if len(x_grid) % 2 == 0:
			mid_x = int(len(x_grid) / 2.0)
			beg_x = np.sum(x_grid[:mid_x]) * -1
		else:
			mid_x = int(len(x_grid) / 2.0) + 1
			beg_x = np.sum(x_grid[:mid_x]) * -1 + (x_grid[mid_x] / 2.0)

		if len(y_grid) % 2 == 0:
			mid_y = int(len(y_grid) / 2.0)
			beg_y = np.sum(y_grid[:mid_y]) * -1
		else:
			mid_y = int(len(y_grid) / 2.0) + 1
			beg_y = np.sum(y_grid[:mid_y]) * -1 + (y_grid[mid_y] / 2.0)

		x_grid_cum = [beg_x]
		for i in range(0, len(x_grid) - 1):
			beg_x += x_grid[i]
			x_grid_cum.append(beg_x)
		y_grid_cum = [beg_y]
		for i in range(0, len(y_grid) - 1):
			beg_y += y_grid[i]
			y_grid_cum.append(beg_y)

		self.x_grid_cum = np.asarray(x_grid_cum[::-1])
		self.y_grid_cum = np.asarray(y_grid_cum)

		self.x_mesh_center = []
		self.y_mesh_center = []
		for i in range(1, len(self.x_grid_cum)):
			self.x_mesh_center.append(((self.x_grid_cum[i] - self.x_grid_cum[i - 1]) / 2.0) + self.x_grid_cum[i - 1])
		for i in range(1, len(self.y_grid_cum)):
			self.y_mesh_center.append(((self.y_grid_cum[i] - self.y_grid_cum[i - 1]) / 2.0) + self.y_grid_cum[i - 1])
		self.x_mesh_center = np.asarray(self.x_mesh_center)
		self.y_mesh_center = np.asarray(self.y_mesh_center)

		self.modem_model_read = True

		QMessageBox.about(self, 'Success', str(filename) +
			' file was succesfully imported to the program!')

