	def load_composition_csv(self):

		filename, _ = QFileDialog.getOpenFileName(self.comp_pop, 'Load composition file',
			self.working_path, 'CSV files (*.csv);;All files (*)')

		if filename == '':
			return

		try:
			df = pd.read_csv(filename)
		except Exception as exc:
			QMessageBox.critical(self.comp_pop, 'MATE 2.0', 'Could not read the file:\n' + str(exc))
			return

		#Mapping the loaded columns onto the expected column set, filling absentees.
		new_df = pd.DataFrame(columns = TABLE_COLUMNS)
		for col in TABLE_COLUMNS:
			if col in df.columns:
				new_df[col] = pd.to_numeric(df[col], errors = 'coerce')
			else:
				new_df[col] = 0.0
		new_df = new_df.fillna(0.0)

		self.table_model.load_dataframe(new_df)
		self.model_built = False

