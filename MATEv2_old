class CompositionTableModel(QAbstractTableModel):

	#Spreadsheet model backed by a pandas DataFrame. All cells are numeric.

	def __init__(self, df = None, parent = None):

		super().__init__(parent)

		if df is None:
			self.df = pd.DataFrame(DEFAULT_ROWS, columns = TABLE_COLUMNS)
		else:
			self.df = df

	def rowCount(self, parent = QModelIndex()):

		return len(self.df)

	def columnCount(self, parent = QModelIndex()):

		return len(self.df.columns)

	def data(self, index, role = Qt.ItemDataRole.DisplayRole):

		if not index.isValid():
			return None

		value = self.df.iat[index.row(), index.column()]

		if role in (Qt.ItemDataRole.DisplayRole, Qt.ItemDataRole.EditRole):
			if pd.isna(value):
				return ''
			if float(value) == int(float(value)):
				return str(int(float(value)))
			return str(value)

		if role == Qt.ItemDataRole.BackgroundRole:
			if pd.isna(value):
				return QColor('#f2b2ac')
			#Highlighting the row red if the mineral fractions do not sum to 100.
			frac_cols = ['ol_frac', 'opx_frac', 'cpx_frac', 'gt_frac', 'sp_chr_frac',
				'pl_frac', 'amp_frac', 'cond_frac']
			if self.df.columns[index.column()] in frac_cols:
				total = self.df.iloc[index.row()][frac_cols].sum()
				if abs(total - 100.0) > 1e-6:
					return QColor('#f2d7ac')

		if role == Qt.ItemDataRole.TextAlignmentRole:
			return Qt.AlignmentFlag.AlignCenter

		return None

	def setData(self, index, value, role = Qt.ItemDataRole.EditRole):

		if role != Qt.ItemDataRole.EditRole:
			return False

		try:
			if str(value).strip() == '':
				numeric = np.nan
			else:
				numeric = float(str(value).replace(',', '.'))
		except ValueError:
			return False

		self.df.iat[index.row(), index.column()] = numeric
		self.dataChanged.emit(index, index)
		#Refreshing whole row so the fraction-sum highlight updates.
		left = self.index(index.row(), 0)
		right = self.index(index.row(), self.columnCount() - 1)
		self.dataChanged.emit(left, right)

		return True

	def headerData(self, section, orientation, role = Qt.ItemDataRole.DisplayRole):

		if role != Qt.ItemDataRole.DisplayRole:
			return None

		if orientation == Qt.Orientation.Horizontal:
			return str(self.df.columns[section])

		return str(section + 1)

	def flags(self, index):

		return (Qt.ItemFlag.ItemIsEnabled | Qt.ItemFlag.ItemIsSelectable |
			Qt.ItemFlag.ItemIsEditable)

	def insert_row(self, position):

		self.beginInsertRows(QModelIndex(), position, position)
		if len(self.df) > 0:
			source = min(position, len(self.df) - 1)
			new_row = self.df.iloc[[source]].copy()
		else:
			new_row = pd.DataFrame([DEFAULT_ROWS[0]], columns = TABLE_COLUMNS)
		upper = self.df.iloc[:position]
		lower = self.df.iloc[position:]
		self.df = pd.concat([upper, new_row, lower], ignore_index = True)
		self.endInsertRows()

	def remove_rows(self, rows):

		for row in sorted(set(rows), reverse = True):
			if len(self.df) <= 1:
				break
			self.beginRemoveRows(QModelIndex(), row, row)
			self.df = self.df.drop(self.df.index[row]).reset_index(drop = True)
			self.endRemoveRows()

	def load_dataframe(self, df):

		self.beginResetModel()
		self.df = df
		self.endResetModel()

class CompositionTableView(QTableView):

	#Table view with block copy/paste, so cells can be exchanged directly with
	#Excel/LibreOffice through the clipboard.

	def keyPressEvent(self, event):

		if event.matches(QKeySequence.StandardKey.Copy):
			self.copy_selection()
		elif event.matches(QKeySequence.StandardKey.Paste):
			self.paste_selection()
		elif event.key() in (Qt.Key.Key_Delete, Qt.Key.Key_Backspace):
			for idx in self.selectedIndexes():
				self.model().setData(idx, '0', Qt.ItemDataRole.EditRole)
		else:
			super().keyPressEvent(event)

	def copy_selection(self):

		selection = self.selectedIndexes()
		if not selection:
			return
		rows = sorted(set(idx.row() for idx in selection))
		cols = sorted(set(idx.column() for idx in selection))
		table = []
		for r in rows:
			line = []
			for c in cols:
				line.append(str(self.model().data(self.model().index(r, c),
					Qt.ItemDataRole.DisplayRole)))
			table.append('\t'.join(line))
		QApplication.clipboard().setText('\n'.join(table))

	def paste_selection(self):

		selection = self.selectedIndexes()
		if not selection:
			return
		start_row = min(idx.row() for idx in selection)
		start_col = min(idx.column() for idx in selection)
		text = QApplication.clipboard().text()
		lines = [ln for ln in text.replace('\r\n', '\n').replace('\r', '\n').split('\n') if ln.strip() != '']
		model = self.model()
		for i, line in enumerate(lines):
			cells = line.split('\t') if '\t' in line else line.split(',')
			target_row = start_row + i
			while target_row >= model.rowCount():
				model.insert_row(model.rowCount())
			for j, cell in enumerate(cells):
				target_col = start_col + j
				if target_col < model.columnCount():
					model.setData(model.index(target_row, target_col), cell,
						Qt.ItemDataRole.EditRole)

